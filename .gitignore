# LaTeX files to ignore

# Compiler-generated files
# -------------------------
# Log files
*.log
# Auxiliary files
*.aux
# Table of contents/list of figures/tables data
*.toc
*.lof
*.lot
# Bibliography files
*.bbl
*.blg
*.nav
*.out
*.snm
# Index files
*.idx
*.ind
*.ilg
# Synctex (source/output synchronization)
*.synctex.gz
*.synctex(.$)
# Drafts/versions
*.dvi
*.ps
# Other common temporary or auxiliary files
*.fls
*.fdb_latexmk
*-blx.bib
_minted-*

# Editor/IDE generated files
# --------------------------
# TeXShop
.texshop/
# TeXstudio
*.txs
# Kile
*.mtc*
# LaTeX Workshop (VSCode)
.vscode/
# JetBrains
.idea/
# General temporary files
*~
.#*
\#*

# Backup/Auto-save files
# ----------------------
*.bak
*.old
*.sav

# Final output files (usually PDF)
# --------------------------------
# PDF binaries are kept in GitHub Releases rather than git history
*.pdf

# Audio recordings & classroom source tasks
# -----------------------------------------
*.m4a
*.mp3
*.wav
*.ogg
tasks/
generic-tasks.txt
exercises/

# Temporary build & scratch directories
# -------------------------------------
tmp/
scratch/
tmpimg/
nanobanana-output/
lod_data/
.antigravitycli/
letz_tmp.tex
letz_tmp_test.*
.texcache/

# Python artifacts
# ----------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
